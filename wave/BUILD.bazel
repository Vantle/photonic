load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

filegroup(
    name = "source",
    srcs = [
        "absent.rs",
        "arena.rs",
        "dispatch.rs",
        "engine.rs",
        "failure.rs",
        "grow.rs",
        "hash.rs",
        "mirror.rs",
        "pass.rs",
        "scan.rs",
        "search.rs",
        "setting.rs",
        "store.rs",
        "table.rs",
        "tally.rs",
        "tuning.rs",
        "upload.rs",
        "wave.rs",
        "window.rs",
        "work.rs",
    ],
)

rust_library(
    name = "wave",
    srcs = [":source"],
    compile_data = ["kernel.metal"],
    crate_root = "wave.rs",
    lint_config = "//:lint",
    visibility = [
        "//benchmark:__pkg__",
        "//command:__pkg__",
    ],
    deps = [
        "//hashing",
        "//language:photonic",
        "//metal",
        "@crate//:thiserror",
    ],
)

# The macOS sandbox denies access to the GPU, so the tests would never reach a Metal device.
rust_test(
    name = "test",
    size = "small",
    srcs = [
        "test/engine.rs",
        "test/suite.rs",
        ":source",
    ],
    compile_data = ["kernel.metal"],
    crate_root = "wave.rs",
    lint_config = "//:lint",
    tags = ["no-sandbox"],
    deps = [
        "//frontend",
        "//hashing",
        "//language:photonic",
        "//metal",
        "@crate//:thiserror",
    ],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
