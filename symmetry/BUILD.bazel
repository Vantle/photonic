load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

filegroup(
    name = "source",
    srcs = [
        "analysis.rs",
        "comparison.rs",
        "forest.rs",
        "graph.rs",
        "group.rs",
        "partition.rs",
        "pattern.rs",
        "rename.rs",
        "search.rs",
        "statement.rs",
        "structure.rs",
        "symmetry.rs",
        "twin.rs",
    ],
)

rust_library(
    name = "symmetry",
    srcs = [":source"],
    crate_root = "symmetry.rs",
    lint_config = "//:lint",
    visibility = [
        "//command:__pkg__",
        "//toolchain/browser:__pkg__",
    ],
    deps = ["//code"],
)

rust_test(
    name = "test",
    size = "small",
    srcs = [
        "test/analysis.rs",
        "test/brute.rs",
        "test/comparison.rs",
        "test/example.rs",
        "test/invariance.rs",
        "test/pattern.rs",
        "test/suite.rs",
        "test/support.rs",
        ":source",
    ],
    crate_root = "symmetry.rs",
    lint_config = "//:lint",
    deps = [
        "//code",
        "//random",
    ],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
