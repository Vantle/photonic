load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@default_rust_toolchains//rustc:component_labels.bzl", "rust_toolchain_component_label")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//photonic:defs.bzl", "photonic_binary", "photonic_test")

rust_library(
    name = "library",
    srcs = [":source"],
    crate_name = "arithmetic",
    crate_root = "library.rs",
    visibility = ["//mathematics:__subpackages__"],
    deps = ["@crate//:thiserror"],
)

rust_binary(
    name = "word",
    srcs = [
        "argument.rs",
        "word.rs",
    ],
    crate_root = "word.rs",
    deps = [
        ":library",
        "//system:photonic",
        "@crate//:clap",
        "@crate//:thiserror",
    ],
)

native_binary(
    name = "format",
    src = "//tool:execute",
    args = [
        "$(rlocationpath {})".format(rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:rustfmt")),
        "--",
        "mathematics/arithmetic/library.rs",
        "mathematics/arithmetic/word.rs",
        "mathematics/arithmetic/test/suite.rs",
        "mathematics/arithmetic/benchmark.rs",
    ],
    data = [rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:rustfmt")],
    tags = ["manual"],
)

rust_test(
    name = "test",
    size = "medium",
    srcs = [
        "argument.rs",
        ":conformance",
    ],
    compile_data = [
        "//mathematics/ternary:fixture",
        ":fixture",
        "//library:source",
    ],
    crate_root = "test/suite.rs",
    data = [":word"],
    env = {"PHOTONIC_WORD": "$(rlocationpath :word)"},
    deps = [
        ":library",
        "//system:photonic",
        "@crate//:clap",
        "@crate//:thiserror",
        "@rules_rust//rust/runfiles",
    ],
)

rust_binary(
    name = "benchmark",
    srcs = ["benchmark.rs"],
    crate_root = "benchmark.rs",
    deps = [
        ":library",
        "//system:photonic",
    ],
)

filegroup(
    name = "source",
    srcs = [
        "address.rs",
        "encoding.rs",
        "failure.rs",
        "format.rs",
        "gate.rs",
        "library.rs",
        "numeral.rs",
        "power.rs",
        ":circuit",
    ],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
    ],
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "gate",
    size = "small",
    srcs = [
        "gate.rs",
        "gate/test.rs",
    ],
    crate_root = "gate.rs",
)

filegroup(
    name = "circuit",
    srcs = [
        "circuit.rs",
        "circuit/emit.rs",
        "circuit/reduce.rs",
    ],
)

filegroup(
    name = "conformance",
    srcs = [
        "test/boundary.rs",
        "test/stream.rs",
        "test/suite.rs",
        "test/ternary.rs",
    ],
)

filegroup(
    name = "fixture",
    srcs = [
        "fixture/ternary/add.particle",
        "fixture/ternary/add.wave",
        "fixture/ternary/divide.particle",
        "fixture/ternary/divide.wave",
        "fixture/ternary/multiply.particle",
        "fixture/ternary/multiply.wave",
        "fixture/ternary/subtract.particle",
        "fixture/ternary/subtract.wave",
    ],
)

photonic_binary(
    name = "ternary.add",
    srcs = ["fixture/ternary/add.wave"],
)

photonic_test(
    name = "ternary.add.check",
    srcs = ["fixture/ternary/add.wave"],
    path = True,
    source = "",
    targets = ["([Digit.0] 0).([Digit.1] 1).([Digit.2] 0).([Digit.3] 0).([Digit.4] 2).([Digit.5] 0).([Digit.6] 2).([Digit.7] 0)"],
)

photonic_binary(
    name = "ternary.subtract",
    srcs = ["fixture/ternary/subtract.wave"],
)

photonic_test(
    name = "ternary.subtract.check",
    srcs = ["fixture/ternary/subtract.wave"],
    path = True,
    source = "",
    targets = ["([Digit.0] 0).([Digit.1] 0).([Digit.2] 0).([Digit.3] 0).([Digit.4] 2).([Digit.5] 2).([Digit.6] 1).([Negative] 0)"],
)

photonic_binary(
    name = "ternary.multiply",
    srcs = ["fixture/ternary/multiply.wave"],
)

photonic_test(
    name = "ternary.multiply.check",
    srcs = ["fixture/ternary/multiply.wave"],
    path = True,
    source = "",
    targets = ["([Digit.0] 0).([Digit.1] 0).([Digit.2] 1).([Digit.3] 2).([Digit.4] 0).([Digit.5] 0).([Digit.6] 1).([Digit.7] 0).([Digit.8] 1).([Digit.9] 0).([Digit.10] 0).([Digit.11] 1).([Digit.12] 0).([Digit.13] 0)"],
)

photonic_binary(
    name = "ternary.divide",
    srcs = ["fixture/ternary/divide.wave"],
)

photonic_test(
    name = "ternary.divide.check",
    srcs = ["fixture/ternary/divide.wave"],
    path = True,
    source = "",
    targets = ["([Quotient.0] 0).([Quotient.1] 1).([Quotient.2] 1).([Quotient.3] 0).([Quotient.4] 0).([Quotient.5] 0).([Quotient.6] 0).([Remainder.0] 0).([Remainder.1] 2).([Remainder.2] 2).([Remainder.3] 0).([Remainder.4] 0).([Remainder.5] 0).([Remainder.6] 0).([Undefined] 0)"],
)
