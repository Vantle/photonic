load("@default_rust_toolchains//rustc:component_labels.bzl", "rust_toolchain_component_label")
load("@hermetic_launcher//launcher:launcher_binary.bzl", "launcher_binary")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "library",
    srcs = [":source"],
    crate_name = "arithmetic",
    crate_root = "library.rs",
    visibility = ["//mathematics:__subpackages__"],
    deps = ["@crate//:thiserror"],
)

rust_binary(
    name = "word",
    srcs = [
        "argument.rs",
        "word.rs",
    ],
    crate_root = "word.rs",
    deps = [
        ":library",
        "//system:photonic",
        "@crate//:clap",
        "@crate//:thiserror",
    ],
)

launcher_binary(
    name = "format",
    embedded_args = [
        "mathematics/arithmetic/library.rs",
        "mathematics/arithmetic/word.rs",
        "mathematics/arithmetic/test.rs",
        "mathematics/arithmetic/benchmark.rs",
    ],
    entrypoint = rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:rustfmt"),
    tags = ["manual"],
)

rust_test(
    name = "test",
    size = "medium",
    srcs = [
        "argument.rs",
        "boundary.rs",
        "stream.rs",
        "ternary.rs",
        "test.rs",
    ],
    compile_data = ["//mathematics/ternary:fixture"],
    crate_root = "test.rs",
    data = [":word"],
    env = {"PHOTONIC_WORD": "$(rlocationpath :word)"},
    deps = [
        ":library",
        "//system:photonic",
        "@crate//:clap",
        "@crate//:thiserror",
        "@rules_rust//rust/runfiles",
    ],
)

rust_binary(
    name = "benchmark",
    srcs = ["benchmark.rs"],
    crate_root = "benchmark.rs",
    deps = [
        ":library",
        "//system:photonic",
    ],
)

filegroup(
    name = "source",
    srcs = [
        "circuit.rs",
        "encoding.rs",
        "failure.rs",
        "format.rs",
        "gate.rs",
        "library.rs",
        "numeral.rs",
        "power.rs",
    ],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
    ],
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "gate",
    size = "small",
    srcs = [
        "gate.rs",
        "gate/test.rs",
    ],
    crate_root = "gate.rs",
)
