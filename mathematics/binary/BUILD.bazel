load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@default_rust_toolchains//rustc:component_labels.bzl", "rust_toolchain_component_label")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("//photonic:defs.bzl", "photonic_binary", "photonic_test")

rust_binary(
    name = "benchmark",
    srcs = ["benchmark.rs"],
    crate_root = "benchmark.rs",
    deps = [
        "//mathematics/arithmetic:library",
        "//system:photonic",
    ],
)

native_binary(
    name = "format",
    src = "//tool:execute",
    args = [
        "$(rlocationpath {})".format(rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:rustfmt")),
        "--",
        "mathematics/binary/benchmark.rs",
    ],
    data = [rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:rustfmt")],
    tags = ["manual"],
)

filegroup(
    name = "fixture",
    srcs = [
        "addition.wave",
        "carry.particle",
        "product.particle",
        "result.particle",
    ],
    visibility = ["//system:__pkg__"],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
    ],
    visibility = ["//:__pkg__"],
)

photonic_binary(
    name = "addition",
    srcs = ["addition.wave"],
)

photonic_test(
    name = "addition.check",
    srcs = ["addition.wave"],
    source = "",
    targets = ["2^0.2^1.2^2.2^4.2^6.2^9.2^10"],
)
