load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "random",
    srcs = ["random.rs"],
    crate_root = "random.rs",
    lint_config = "//:lint",
    visibility = [
        "//gpu:__pkg__",
        "//learning:__pkg__",
        "//network:__pkg__",
        "//symmetry:__pkg__",
        "//translation:__pkg__",
    ],
    deps = ["//hashing"],
)

rust_test(
    name = "test",
    size = "small",
    srcs = [
        "random.rs",
        "test.rs",
    ],
    crate_root = "random.rs",
    lint_config = "//:lint",
    deps = ["//hashing"],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
