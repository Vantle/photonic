load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

exports_files(
    ["parser.rs"],
    visibility = [
        "//book:__pkg__",
        "//spectrum:__pkg__",
    ],
)

rust_library(
    name = "frontend",
    srcs = [
        "expansion.rs",
        "failure.rs",
        "frontend.rs",
        "lowering.rs",
        "parser.rs",
        "partition.rs",
        "size.rs",
        "source.rs",
        "syntax.rs",
        "text.rs",
        "validation.rs",
    ],
    crate_root = "frontend.rs",
    lint_config = "//:lint",
    proc_macro_deps = ["@crate//:pest_derive"],
    visibility = [
        "//arithmetic:__pkg__",
        "//benchmark:__pkg__",
        "//command:__pkg__",
        "//language:__pkg__",
        "//learning:__pkg__",
        "//library:__pkg__",
        "//photonic:__pkg__",
        "//spectrum:__pkg__",
        "//toolchain/browser:__pkg__",
        "//translation:__pkg__",
    ],
    deps = [
        "@crate//:miette",
        "@crate//:pest",
        "@crate//:serde",
        "@crate//:serde_json",
        "@crate//:thiserror",
    ],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "test",
    srcs = [
        "test/lowering.rs",
        "test/parser.rs",
        "test/partition.rs",
        "test/suite.rs",
    ],
    compile_data = ["//program/language:fixture"],
    crate_root = "test/suite.rs",
    lint_config = "//:lint",
    deps = [
        ":frontend",
        "@crate//:serde_json",
    ],
)
