load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

filegroup(
    name = "source",
    srcs = [
        "coherence.rs",
        "event.rs",
        "exploration.rs",
        "flat.rs",
        "limit.rs",
        "machine.rs",
        "schedule.rs",
        "state.rs",
        "walk.rs",
    ],
)

rust_library(
    name = "machine",
    srcs = [":source"],
    crate_root = "machine.rs",
    lint_config = "//:lint",
    visibility = [
        "//learning:__pkg__",
        "//translation:__pkg__",
    ],
    deps = [
        "//code",
        "@crate//:serde",
    ],
)

rust_test(
    name = "test",
    size = "small",
    srcs = [
        "test/exploration.rs",
        "test/schedule.rs",
        "test/suite.rs",
        "test/support.rs",
        "test/walk.rs",
        ":source",
    ],
    crate_root = "machine.rs",
    lint_config = "//:lint",
    deps = [
        "//code",
        "@crate//:serde",
    ],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
