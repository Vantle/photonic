load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

filegroup(
    name = "source",
    srcs = [
        "atom.rs",
        "canonical.rs",
        "code.rs",
        "configuration.rs",
        "forest.rs",
        "hashing.rs",
        "observation.rs",
        "output.rs",
        "particle.rs",
        "program.rs",
        "rule.rs",
        "value.rs",
    ],
)

rust_library(
    name = "code",
    srcs = [":source"],
    crate_root = "code.rs",
    lint_config = "//:lint",
    visibility = [
        "//learning:__pkg__",
        "//machine:__pkg__",
        "//spectrum:__pkg__",
        "//symmetry:__pkg__",
        "//toolchain/browser:__pkg__",
        "//translation:__pkg__",
    ],
    deps = ["@crate//:serde"],
)

rust_test(
    name = "test",
    size = "small",
    srcs = [
        "test/canonical.rs",
        "test/forest.rs",
        "test/observation.rs",
        "test/program.rs",
        "test/suite.rs",
        "test/support.rs",
        ":source",
    ],
    crate_root = "code.rs",
    lint_config = "//:lint",
    deps = ["@crate//:serde"],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
