load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("//toolchain:defs.bzl", "hermetic_binary")

rust_binary(
    name = "arithmetic",
    srcs = ["arithmetic.rs"],
    compile_data = ["//program/ternary:formula"],
    crate_root = "arithmetic.rs",
    rustc_env = {"FORMULA": "$(execpath //program/ternary:formula)"},
    deps = [
        "//language:photonic",
        "@crate//:clap",
        "@crate//:serde",
        "@crate//:serde_json",
    ],
)

hermetic_binary(
    name = "browser",
    argument = [
        "$(rlocationpath //toolchain:node)",
        "$(rlocationpath browser.mjs)",
        "$(rlocationpath //toolchain/browser:webassembly)",
        "$(rlocationpath //toolchain/browser:javascript)",
        "$(rlocationpath //document:numeral)",
    ],
    data = [
        "browser.mjs",
        "//document:numeral",
        "//toolchain:node",
        "//toolchain/browser:javascript",
        "//toolchain/browser:webassembly",
    ],
    entrypoint = "//toolchain:execute",
)

rust_binary(
    name = "runtime",
    srcs = ["runtime.rs"],
    compile_data = ["//language:fixture"],
    crate_root = "runtime.rs",
    deps = [
        "//language:photonic",
        "@crate//:clap",
        "@crate//:serde",
        "@crate//:serde_json",
    ],
)

rust_binary(
    name = "symmetry",
    srcs = ["symmetry.rs"],
    crate_root = "symmetry.rs",
    deps = [
        "//language:measurement",
        "@crate//:serde",
        "@crate//:serde_json",
    ],
)

rust_binary(
    name = "trace",
    srcs = ["trace.rs"],
    crate_root = "trace.rs",
    deps = [
        "//language:photonic",
        "@crate//:clap",
        "@crate//:serde",
        "@crate//:serde_json",
    ],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

rust_binary(
    name = "matching",
    srcs = ["matching.rs"],
    crate_root = "matching.rs",
    data = [
        "case/coherence.wave",
        "case/token.wave",
    ],
    deps = [
        "//language:photonic",
        "@crate//:clap",
        "@crate//:serde",
        "@crate//:serde_json",
    ],
)
