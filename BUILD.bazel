load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@default_rust_toolchains//rustc:component_labels.bzl", "rust_toolchain_component_label")

native_binary(
    name = "analyze.rust",
    src = "@rules_rs//tools/rust_analyzer:gen_rust_project",
    tags = ["manual"],
)

native_binary(
    name = "format",
    src = "//tool:execute",
    args = [
        "$(rlocationpath {})".format(rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:rustfmt")),
        "--",
        "system/photonic.rs",
        "system/test/suite.rs",
        "system/command.rs",
        "system/benchmark.rs",
        "system/benchmark/symmetry.rs",
        "system/benchmark/trace.rs",
        "library/test/suite.rs",
        "photonic/assemble.rs",
        "photonic/check.rs",
        "browser/engine.rs",
        "browser/serve.rs",
        "photonic/launch.rs",
        "photonic/test.rs",
        "tool/execute.rs",
        "tool/test.rs",
    ],
    data = [rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:rustfmt")],
    tags = ["manual"],
)

native_binary(
    name = "update",
    src = "//tool:execute",
    args = [
        "$(rlocationpath {})".format(rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:cargo")),
        "--",
        "update",
    ],
    data = [rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:cargo")],
    tags = ["manual"],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
        "//browser:build",
        "//document:build",
        "//example:build",
        "//example/counterexample:build",
        "//example/group:build",
        "//example/library:build",
        "//library:build",
        "//mathematics/arithmetic:build",
        "//mathematics/binary:build",
        "//mathematics/decimal:build",
        "//mathematics/natural:build",
        "//mathematics/ternary:build",
        "//photonic:build",
        "//platform:build",
        "//system:build",
        "//tool:build",
    ],
    visibility = ["//tool:__pkg__"],
)

filegroup(
    name = "page",
    srcs = ["index.html"],
    visibility = ["//tool:__pkg__"],
)
