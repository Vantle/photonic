load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@default_rust_toolchains//rustc:component_labels.bzl", "rust_toolchain_component_label")

native_binary(
    name = "analyze.rust",
    src = "@rules_rs//tools/rust_analyzer:gen_rust_project",
    tags = ["manual"],
)

native_binary(
    name = "format",
    src = "//toolchain:execute",
    args = [
        "$(rlocationpath {})".format(rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:rustfmt")),
        "--",
        "language/photonic.rs",
        "language/test/suite.rs",
        "command/main.rs",
        "command/test.rs",
        "arithmetic/library.rs",
        "arithmetic/word.rs",
        "arithmetic/test/suite.rs",
        "arithmetic/benchmark.rs",
        "program/binary/benchmark.rs",
        "benchmark/runtime.rs",
        "benchmark/symmetry.rs",
        "benchmark/trace.rs",
        "benchmark/matching.rs",
        "benchmark/arithmetic.rs",
        "library/test/suite.rs",
        "photonic/assemble.rs",
        "photonic/check.rs",
        "toolchain/browser/engine.rs",
        "toolchain/browser/serve.rs",
        "photonic/launch.rs",
        "photonic/test.rs",
        "toolchain/execute.rs",
        "toolchain/test.rs",
    ],
    data = [rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:rustfmt")],
    tags = ["manual"],
)

native_binary(
    name = "update",
    src = "//toolchain:execute",
    args = [
        "$(rlocationpath {})".format(rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:cargo")),
        "--",
        "update",
    ],
    data = [rust_toolchain_component_label("@rules_rust//tools/upstream_wrapper:cargo")],
    tags = ["manual"],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
        "//arithmetic:build",
        "//benchmark:build",
        "//command:build",
        "//document:build",
        "//language:build",
        "//library:build",
        "//photonic:build",
        "//platform:build",
        "//program/association:build",
        "//program/binary:build",
        "//program/circuit:build",
        "//program/composition:build",
        "//program/decimal:build",
        "//program/language:build",
        "//program/natural:build",
        "//program/ternary:build",
        "//program/ternary/case:build",
        "//toolchain:build",
        "//toolchain/browser:build",
    ],
    visibility = ["//toolchain:__pkg__"],
)

filegroup(
    name = "page",
    srcs = ["index.html"],
    visibility = ["//toolchain/browser:__pkg__"],
)
