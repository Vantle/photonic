load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "photonic",
    srcs = [":source"],
    crate_root = "photonic.rs",
    proc_macro_deps = ["@crate//:pest_derive"],
    visibility = ["//visibility:public"],
    deps = [
        "@crate//:indexmap",
        "@crate//:miette",
        "@crate//:pest",
        "@crate//:rayon",
        "@crate//:serde",
        "@crate//:thiserror",
    ],
)

rust_binary(
    name = "command",
    srcs = [
        "command.rs",
        "command/argument.rs",
    ],
    crate_root = "command.rs",
    deps = [
        ":photonic",
        "@crate//:clap",
        "@crate//:miette",
        "@crate//:serde_json",
    ],
)

rust_test(
    name = "test",
    size = "medium",
    srcs = [
        "test/addition.rs",
        "test/agenda.rs",
        "test/binary.rs",
        "test/command.rs",
        "test/executor.rs",
        "test/group.rs",
        "test/lowering.rs",
        "test/multiplication.rs",
        "test/natural.rs",
        "test/obsidian.rs",
        "test/ordering.rs",
        "test/parser.rs",
        "test/particle.rs",
        "test/path.rs",
        "test/product.rs",
        "test/rule.rs",
        "test/runtime.rs",
        "test/scheduling.rs",
        "test/suite.rs",
        "test/support.rs",
        ":source",
    ],
    compile_data = [
        "//example:fixture",
        "//example/group:fixture",
        "//mathematics/binary:fixture",
        "//mathematics/decimal:fixture",
        "//mathematics/natural:fixture",
    ],
    crate_root = "photonic.rs",
    data = [":command"],
    env = {"PHOTONIC_COMMAND": "$(rlocationpath :command)"},
    proc_macro_deps = ["@crate//:pest_derive"],
    deps = [
        "@crate//:indexmap",
        "@crate//:miette",
        "@crate//:pest",
        "@crate//:rayon",
        "@crate//:serde",
        "@crate//:serde_json",
        "@crate//:thiserror",
        "@rules_rust//rust/runfiles",
    ],
)

rust_binary(
    name = "benchmark",
    srcs = ["benchmark.rs"],
    compile_data = ["//example:fixture"],
    crate_root = "benchmark.rs",
    deps = [
        ":photonic",
        "@crate//:clap",
        "@crate//:serde",
        "@crate//:serde_json",
    ],
)

rust_binary(
    name = "symmetry",
    srcs = ["benchmark/symmetry.rs"],
    crate_root = "benchmark/symmetry.rs",
    deps = [
        ":measurement",
        "@crate//:serde",
        "@crate//:serde_json",
    ],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
    ],
    visibility = ["//:__pkg__"],
)

filegroup(
    name = "source",
    srcs = [
        "agenda.rs",
        "canonical.rs",
        "executor.rs",
        "expansion.rs",
        "failure.rs",
        "flow.rs",
        "lowering.rs",
        "matching.rs",
        "obsidian.rs",
        "ordering.rs",
        "parser.rs",
        "particle.rs",
        "path.rs",
        "photonic.rs",
        "program.rs",
        "refinement.rs",
        "rule.rs",
        "runtime.rs",
        "runtime/report.rs",
        "search.rs",
        "snapshot.rs",
        "source.rs",
        "state.rs",
        "support.rs",
        "symmetry.rs",
        "syntax.rs",
        "work.rs",
    ],
)

rust_library(
    name = "measurement",
    srcs = [
        "measurement.rs",
        ":source",
    ],
    crate_features = ["measurement"],
    crate_name = "photonic",
    crate_root = "photonic.rs",
    proc_macro_deps = ["@crate//:pest_derive"],
    deps = [
        "@crate//:indexmap",
        "@crate//:miette",
        "@crate//:pest",
        "@crate//:rayon",
        "@crate//:serde",
        "@crate//:thiserror",
    ],
)
