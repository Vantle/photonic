load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "library",
    srcs = [":source"],
    crate_name = "arithmetic",
    crate_root = "library.rs",
    lint_config = "//:lint",
    deps = ["@crate//:thiserror"],
)

rust_library(
    name = "infix",
    srcs = ["infix.rs"],
    crate_root = "infix.rs",
    lint_config = "//:lint",
    visibility = [
        "//benchmark:__pkg__",
        "//toolchain/browser:__pkg__",
    ],
)

rust_binary(
    name = "word",
    srcs = [
        "argument.rs",
        "search.rs",
        "word.rs",
    ],
    crate_root = "word.rs",
    lint_config = "//:lint",
    deps = [
        ":library",
        "//frontend",
        "//language:photonic",
        "@crate//:clap",
        "@crate//:serde_json",
        "@crate//:thiserror",
    ],
)

rust_test(
    name = "test",
    size = "medium",
    srcs = [
        "argument.rs",
        "search.rs",
        ":conformance",
    ],
    compile_data = [
        "//program/circuit:fixture",
        "//program/ternary:fixture",
    ],
    crate_root = "test/suite.rs",
    data = [":word"],
    env = {"PHOTONIC_WORD": "$(rlocationpath :word)"},
    lint_config = "//:lint",
    deps = [
        ":library",
        "//frontend",
        "//language:photonic",
        "@crate//:clap",
        "@crate//:serde_json",
        "@crate//:thiserror",
        "@rules_rust//rust/runfiles",
    ],
)

filegroup(
    name = "source",
    srcs = [
        "address.rs",
        "encoding.rs",
        "failure.rs",
        "format.rs",
        "gate.rs",
        "library.rs",
        "numeral.rs",
        ":circuit",
    ],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
    ],
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "gate",
    size = "small",
    srcs = [
        "gate.rs",
        "gate/test.rs",
    ],
    crate_root = "gate.rs",
    lint_config = "//:lint",
)

filegroup(
    name = "circuit",
    srcs = [
        "circuit.rs",
        "circuit/emit.rs",
        "circuit/reduce.rs",
    ],
)

filegroup(
    name = "conformance",
    srcs = [
        "test/boundary.rs",
        "test/suite.rs",
        "test/ternary.rs",
    ],
)
