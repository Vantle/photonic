#!/usr/bin/env bash
set -euo pipefail

if [[ "${BUILDKITE_STEP_KEY:-}" == upload ]]; then
    exit 0
fi

case "$(uname -s)/$(uname -m)" in
    Linux/x86_64)
        platform=linux-amd64
        checksum=22e7d3a188699982f661cf4687137ee52d1f24fec1ec893d91a6c4d791a75de8
        ;;
    Linux/aarch64)
        platform=linux-arm64
        checksum=8ded44b58a0d9425a4178af26cf17693feac3b87bdcfef0a2a0898fcd1afc9f2
        ;;
    Darwin/arm64)
        platform=darwin-arm64
        checksum=dea3f3f5de2dbc5e269e0132cdd369d5efe738f7b973d5d4eb2b4f7055a97b39
        ;;
    Darwin/x86_64)
        platform=darwin-amd64
        checksum=023225736cea5dc88f2b0807d5b1af4eb0f69a4ed45e3994b2c18c263bc80e48
        ;;
    *)
        printf 'Unsupported agent platform\n' >&2
        exit 1
        ;;
esac

directory="$BUILDKITE_BUILD_CHECKOUT_PATH/.cache/bootstrap/1.28.1/$platform"
mkdir -p "$directory"
if [[ ! -f "$directory/bazel" ]]; then
    download="$(mktemp "$directory/download.XXXXXX")"
    curl --fail --silent --show-error --location --retry 3 \
        "https://github.com/bazelbuild/bazelisk/releases/download/v1.28.1/bazelisk-$platform" \
        --output "$download"
    printf '%s  %s\n' "$checksum" "$download" | shasum -a 256 --check
    chmod +x "$download"
    mv "$download" "$directory/bazel"
fi
printf '%s  %s\n' "$checksum" "$directory/bazel" | shasum -a 256 --check
export PATH="$directory:$PATH"
export BAZELISK_HOME="$BUILDKITE_BUILD_CHECKOUT_PATH/.cache/bazelisk"
printf 'build --disk_cache="%s/.cache/action"\ncommon --repository_cache="%s/.cache/repository"\n' \
    "$BUILDKITE_BUILD_CHECKOUT_PATH" "$BUILDKITE_BUILD_CHECKOUT_PATH" > user.bazelrc
