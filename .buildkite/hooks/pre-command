#!/usr/bin/env bash
set -euo pipefail

if [[ "${BUILDKITE_STEP_KEY:-}" == upload ]]; then
    exit 0
fi

if [[ "$(uname -s)/$(uname -m)" != Linux/x86_64 ]]; then
    printf 'Expected a hosted Linux x86-64 agent\n' >&2
    exit 1
fi

checksum=22e7d3a188699982f661cf4687137ee52d1f24fec1ec893d91a6c4d791a75de8
directory=/tmp/photonic/bootstrap/1.28.1
mkdir -p "$directory"
if [[ ! -f "$directory/bazel" ]]; then
    download="$(mktemp "$directory/download.XXXXXX")"
    curl --fail --silent --show-error --location --retry 3 \
        https://github.com/bazelbuild/bazelisk/releases/download/v1.28.1/bazelisk-linux-amd64 \
        --output "$download"
    printf '%s  %s\n' "$checksum" "$download" | shasum -a 256 --check
    chmod +x "$download"
    mv "$download" "$directory/bazel"
fi
printf '%s  %s\n' "$checksum" "$directory/bazel" | shasum -a 256 --check
export PATH="$directory:$PATH"
export BAZELISK_HOME=/tmp/photonic/bazelisk
cat > user.bazelrc <<'BAZEL'
startup --host_jvm_args=-Xmx1024m
common --repository_cache=/tmp/photonic/repository
build --disk_cache=/tmp/photonic/action
build --jobs=2
BAZEL
