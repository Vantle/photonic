load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load(":defs.bzl", "hermetic_binary")
load(":node.bzl", "node")
load(":starlark.bzl", "buildifier", "starlark")

starlark(
    name = "check",
    source = "//:build",
)

buildifier(
    name = "buildifier",
    visibility = ["//:__pkg__"],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
        "check.bzl",
        "defs.bzl",
        "node.bzl",
        "release.bzl",
        "starlark.bzl",
    ],
    visibility = ["//:__pkg__"],
)

node(name = "node")

rust_binary(
    name = "execute",
    srcs = ["execute.rs"],
    crate_root = "execute.rs",
    lint_config = "//:lint",
    deps = [
        ":relay",
        "@rules_rust//rust/runfiles",
    ],
)

rust_library(
    name = "relay",
    srcs = ["relay.rs"],
    crate_root = "relay.rs",
    lint_config = "//:lint",
    visibility = ["//photonic:__pkg__"],
    deps = ["@crate//:thiserror"],
)

rust_test(
    name = "runner",
    size = "small",
    srcs = ["test.rs"],
    crate_root = "test.rs",
    data = [
        "exit.mjs",
        ":argument",
        ":execute",
        ":node",
        ":probe",
        ":sample",
        ":verify",
    ],
    env = {
        "VERIFY": "$(rlocationpath :verify)",
        "SAMPLE": "$(rlocationpath :sample)",
        "ARGUMENT": "$(rlocationpath :argument)",
        "PROBE": "$(rlocationpath :probe)",
        "PHOTONIC_EXECUTE": "$(rlocationpath :execute)",
        "PHOTONIC_NODE": "$(rlocationpath :node)",
        "PHOTONIC_SCRIPT": "$(rlocationpath exit.mjs)",
    },
    lint_config = "//:lint",
    deps = ["@rules_rust//rust/runfiles"],
)

rust_binary(
    name = "probe",
    testonly = True,
    srcs = ["probe.rs"],
    crate_root = "probe.rs",
    lint_config = "//:lint",
)

hermetic_binary(
    name = "sample",
    testonly = True,
    argument = [str(value) for value in range(20)] + [
        "",
        "space value",
        "雪",
    ],
    entrypoint = ":probe",
)

rust_binary(
    name = "argument",
    srcs = ["argument.rs"],
    crate_root = "argument.rs",
    lint_config = "//:lint",
    deps = [
        ":relay",
        "@crate//:serde_json",
    ],
)

rust_binary(
    name = "verify",
    srcs = ["verify.rs"],
    crate_root = "verify.rs",
    lint_config = "//:lint",
    deps = [":relay"],
)

rust_binary(
    name = "link",
    srcs = [
        "link.rs",
        "markup.rs",
    ],
    crate_root = "link.rs",
    lint_config = "//:lint",
    visibility = ["//:__pkg__"],
    deps = [":relay"],
)

rust_test(
    name = "markup",
    size = "small",
    srcs = [
        "markup.rs",
        "test/markup.rs",
    ],
    crate_root = "markup.rs",
    lint_config = "//:lint",
)

rust_binary(
    name = "install",
    srcs = ["install.rs"],
    crate_root = "install.rs",
    lint_config = "//:lint",
    visibility = ["//:__pkg__"],
    deps = [
        ":relay",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "installation",
    size = "small",
    srcs = ["installation.rs"],
    crate_root = "installation.rs",
    data = [
        ":install",
        ":probe",
        "//:release",
    ],
    env = {
        "INSTALL": "$(rlocationpath :install)",
        "PROBE": "$(rlocationpath :probe)",
        "RELEASE": "$(rlocationpath //:release)",
    },
    lint_config = "//:lint",
    deps = ["@rules_rust//rust/runfiles"],
)

rust_binary(
    name = "workspace",
    srcs = ["workspace.rs"],
    crate_root = "workspace.rs",
    lint_config = "//:lint",
    visibility = ["//:__pkg__"],
    deps = [
        ":relay",
        "@rules_rust//rust/runfiles",
    ],
)

rust_binary(
    name = "format",
    srcs = ["format.rs"],
    crate_root = "format.rs",
    lint_config = "//:lint",
    visibility = ["//:__pkg__"],
    deps = [
        ":relay",
        "@rules_rust//rust/runfiles",
    ],
)
