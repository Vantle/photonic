load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load(":defs.bzl", "hermetic_binary")
load(":node.bzl", "node")
load(":starlark.bzl", "starlark")

exports_files(["defs.bzl"])

starlark(
    name = "check",
    source = "//:build",
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
        "check.bzl",
        "defs.bzl",
        "node.bzl",
        "starlark.bzl",
    ],
    visibility = ["//:__pkg__"],
)

node(
    name = "node",
    visibility = [
        "//benchmark:__pkg__",
        "//program/ternary:__pkg__",
        "//toolchain/browser:__pkg__",
    ],
)

rust_binary(
    name = "execute",
    srcs = ["execute.rs"],
    crate_root = "execute.rs",
    lint_config = "//:lint",
    visibility = [
        "//:__pkg__",
        "//benchmark:__pkg__",
        "//program/ternary:__pkg__",
        "//toolchain/browser:__pkg__",
    ],
    deps = ["@rules_rust//rust/runfiles"],
)

rust_test(
    name = "runner",
    size = "small",
    srcs = ["test.rs"],
    crate_root = "test.rs",
    data = [
        "exit.mjs",
        ":argument",
        ":execute",
        ":node",
        ":probe",
        ":sample",
        ":verify",
    ],
    env = {
        "VERIFY": "$(rlocationpath :verify)",
        "SAMPLE": "$(rlocationpath :sample)",
        "ARGUMENT": "$(rlocationpath :argument)",
        "PROBE": "$(rlocationpath :probe)",
        "PHOTONIC_EXECUTE": "$(rlocationpath :execute)",
        "PHOTONIC_NODE": "$(rlocationpath :node)",
        "PHOTONIC_SCRIPT": "$(rlocationpath exit.mjs)",
    },
    lint_config = "//:lint",
    deps = ["@rules_rust//rust/runfiles"],
)

rust_binary(
    name = "probe",
    testonly = True,
    srcs = ["probe.rs"],
    crate_root = "probe.rs",
    lint_config = "//:lint",
)

hermetic_binary(
    name = "sample",
    testonly = True,
    argument = [str(value) for value in range(20)] + [
        "",
        "space value",
        "雪",
    ],
    entrypoint = ":probe",
)

rust_binary(
    name = "argument",
    srcs = ["argument.rs"],
    crate_root = "argument.rs",
    lint_config = "//:lint",
    deps = ["@crate//:serde_json"],
)

rust_binary(
    name = "verify",
    srcs = ["verify.rs"],
    crate_root = "verify.rs",
    lint_config = "//:lint",
)

rust_binary(
    name = "format",
    srcs = ["format.rs"],
    crate_root = "format.rs",
    lint_config = "//:lint",
    visibility = ["//:__pkg__"],
    deps = ["@rules_rust//rust/runfiles"],
)
