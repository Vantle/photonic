load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")
load("//toolchain:defs.bzl", "script_test")
load(":defs.bzl", "asset")

rust_shared_library(
    name = "engine",
    srcs = [
        "analysis.rs",
        "catalog.rs",
        "configuration.rs",
        "engine.rs",
        "execution.rs",
        "expression.rs",
        "failure.rs",
        "limit.rs",
        "path.rs",
        "request.rs",
        "response.rs",
        "selection.rs",
        "shape.rs",
    ],
    compile_data = ["//library/expression:evaluate"],
    crate_root = "engine.rs",
    lint_config = "//:lint",
    rustc_env = {
        "FORMULA": "$(execpath //library/expression:evaluate)",
    },
    rustc_flags = ["-Clink-arg=--max-memory=1073741824"],
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [
        "//arithmetic:infix",
        "//code",
        "//frontend",
        "//language:photonic",
        "//spectrum",
        "//symmetry",
        "//translation",
        "@crate//:miette",
        "@crate//:serde",
        "@crate//:serde_json",
        "@crate//:wasm-bindgen",
    ],
)

rust_wasm_bindgen(
    name = "module",
    out_name = "runtime",
    target = "web",
    wasm_file = ":engine",
)

asset(
    name = "asset",
    source = ":module",
)

filegroup(
    name = "javascript",
    srcs = [":asset"],
    output_group = "javascript",
    visibility = ["//book:__pkg__"],
)

filegroup(
    name = "webassembly",
    srcs = [":asset"],
    output_group = "webassembly",
    visibility = ["//book:__pkg__"],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    visibility = ["//:__pkg__"],
)

script_test(
    name = "test",
    size = "small",
    runfile = [
        ":webassembly",
        ":javascript",
        "//command:photonic",
    ],
    script = "test.mjs",
)
