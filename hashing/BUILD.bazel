load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "hashing",
    srcs = ["hashing.rs"],
    crate_root = "hashing.rs",
    lint_config = "//:lint",
    visibility = [
        "//code:__pkg__",
        "//language:__pkg__",
        "//learning:__pkg__",
        "//machine:__pkg__",
        "//random:__pkg__",
        "//spectrum:__pkg__",
        "//symmetry:__pkg__",
    ],
)

rust_test(
    name = "test",
    size = "small",
    srcs = [
        "hashing.rs",
        "test.rs",
    ],
    crate_root = "hashing.rs",
    lint_config = "//:lint",
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
