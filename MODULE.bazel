module(
    name = "photonic",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True)

bazel_dep(name = "hermetic_launcher", version = "0.0.15")
single_version_override(
    module_name = "hermetic_launcher",
    patch_strip = 1,
    patches = ["//platform:launcher.patch"],
)

bazel_dep(name = "llvm", version = "0.8.19")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rs", version = "0.0.110")
single_version_override(
    module_name = "rules_rs",
    patch_strip = 1,
    patches = ["//platform:rust.patch"],
)

toolchain = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")

determinism = {
    target: ["-Clink-arg=-Wl,--no-insert-timestamp"]
    for target in [
        "aarch64-pc-windows-gnullvm",
        "x86_64-pc-windows-gnullvm",
    ]
}

toolchain.toolchain(
    edition = "2024",
    extra_exec_rustc_flags = determinism,
    extra_rustc_flags = determinism,
    use_rust_redist = False,
    version = "1.98.1",
)
use_repo(toolchain, "default_rust_toolchains")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crate",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    generate_lint_config = True,
    platform_triples = [
        "wasm32-unknown-unknown",
        "aarch64-apple-darwin",
        "aarch64-pc-windows-gnullvm",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-gnullvm",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crate")

rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rust, "rules_rust")

bazel_dep(name = "rules_browsers", version = "0.4.0", dev_dependency = True)
bazel_dep(name = "rules_nodejs", version = "6.7.5", dev_dependency = True)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node", dev_dependency = True)
node.toolchain(node_version = "22.18.0")
use_repo(node, "nodejs_toolchains")

browser = use_extension("@rules_browsers//browsers:extensions.bzl", "browsers", dev_dependency = True)
browser.chrome(version = "147.0.7687.0")
browser.chromedriver(version = "147.0.7687.0")
use_repo(browser, "rules_browsers_chrome_mac_arm", "rules_browsers_chromedriver_mac_arm")

wasm = use_extension("@rules_rs//rs:rules_rust_wasm_bindgen.bzl", "rules_rust_wasm_bindgen")
use_repo(wasm, "rules_rust_wasm_bindgen")

binding = use_extension("//toolchain/wasm:extension.bzl", "binding")
use_repo(binding, "aarch64-apple-darwin", "aarch64-unknown-linux-musl", "x86_64-apple-darwin", "x86_64-unknown-linux-musl")

register_toolchains(
    "//toolchain/wasm:aarch64-apple-darwin",
    "//toolchain/wasm:x86_64-apple-darwin",
    "//toolchain/wasm:aarch64-unknown-linux-musl",
    "//toolchain/wasm:x86_64-unknown-linux-musl",
    "@rules_rust_wasm_bindgen//:default_wasm_bindgen_toolchain",
)

archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

archive(
    name = "reference",
    dev_dependency = True,
    patch_args = ["-p1"],
    patches = ["//benchmark:reference.patch"],
    sha256 = "c0fbb9bd21c0ca0d7f03201a52984a79278e7d4f08d1b65003b06e8dd31ebad4",
    strip_prefix = "photonic-8c68ad69196f77c2601d294ac5c23b13505f2175",
    type = "tar.gz",
    urls = ["https://codeload.github.com/Vantle/photonic/tar.gz/8c68ad69196f77c2601d294ac5c23b13505f2175"],
)
