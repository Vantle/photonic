load("//photonic:defs.bzl", "photonic_test")
load("//theorem:defs.bzl", "theorem")

theorem(
    name = "associativity",
    srcs = ["associativity.wave"],
    configuration = 65536,
    every = True,
    deps = [
        "//library/ternary:sum",
        "//theorem:case",
        "//theorem/ternary:unpack",
    ],
)

theorem(
    name = "lookahead",
    srcs = ["lookahead.wave"],
    deps = [
        "//library/carry:combine",
        "//library/carry:evaluate",
        "//library/ternary:equal",
        "//theorem:case",
        "//theorem/carry:role",
    ],
)

photonic_test(
    name = "lookahead.order",
    srcs = ["lookahead.wave"],
    configuration = 131072,
    every = True,
    tags = ["memory"],
    target = ["Theorem"],
    deps = [
        "//library/carry:combine",
        "//library/carry:evaluate",
        "//library/ternary:equal",
        "//theorem:case",
        "//theorem/carry:role",
    ],
)

theorem(
    name = "subtraction",
    srcs = ["subtraction.wave"],
    every = True,
    deps = [
        "//library/ternary:equal",
        "//library/ternary:subtract",
        "//library/ternary:sum",
        "//theorem:case",
        "//theorem/ternary:role",
        "//theorem/ternary:unpack",
    ],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
