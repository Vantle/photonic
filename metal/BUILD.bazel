load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

filegroup(
    name = "source",
    srcs = [
        "device.rs",
        "failure.rs",
        "metal.rs",
        "operand.rs",
        "plain.rs",
    ],
)

rust_library(
    name = "metal",
    srcs = [":source"],
    crate_root = "metal.rs",
    lint_config = "//:lint",
    visibility = [
        "//gpu:__pkg__",
        "//wave:__pkg__",
    ],
    deps = ["@crate//:thiserror"],
)

# The macOS sandbox denies access to the GPU, so the tests would never reach a Metal device.
rust_test(
    name = "test",
    size = "small",
    srcs = [
        "test/device.rs",
        "test/suite.rs",
        ":source",
    ],
    crate_root = "metal.rs",
    lint_config = "//:lint",
    tags = ["no-sandbox"],
    deps = [
        "//random",
        "@crate//:thiserror",
    ],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
