load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "model",
    srcs = [
        "construction.rs",
        "context.rs",
        "evidence.rs",
        "failure.rs",
        "fragment.rs",
        "history.rs",
        "model.rs",
        "occurrence.rs",
        "structure.rs",
    ],
    crate_root = "model.rs",
    lint_config = "//:lint",
)

rust_test(
    name = "test",
    srcs = ["test/suite.rs"],
    crate_root = "test/suite.rs",
    lint_config = "//:lint",
    deps = [":model"],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
