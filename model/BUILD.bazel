load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "model",
    srcs = [
        "activation.rs",
        "allocation.rs",
        "application.rs",
        "argument.rs",
        "binding.rs",
        "configuration.rs",
        "construction.rs",
        "context.rs",
        "environment.rs",
        "evidence.rs",
        "failure.rs",
        "flow.rs",
        "fragment.rs",
        "generator.rs",
        "history.rs",
        "introduction.rs",
        "machine.rs",
        "model.rs",
        "occurrence.rs",
        "parameter.rs",
        "quotation.rs",
        "scope.rs",
        "slot.rs",
        "structure.rs",
        "template.rs",
        "world.rs",
    ],
    crate_root = "model.rs",
    lint_config = "//:lint",
)

rust_test(
    name = "test",
    srcs = [
        "test/activation.rs",
        "test/application.rs",
        "test/declaration.rs",
        "test/flow.rs",
        "test/generator.rs",
        "test/introduction.rs",
        "test/machine.rs",
        "test/suite.rs",
        "test/template.rs",
    ],
    crate_root = "test/suite.rs",
    lint_config = "//:lint",
    deps = [":model"],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "conformance",
    srcs = [
        "test/conformance.rs",
        "test/program.rs",
    ],
    crate_root = "test/conformance.rs",
    lint_config = "//:lint",
    deps = [
        ":model",
        "//language:photonic",
    ],
)
