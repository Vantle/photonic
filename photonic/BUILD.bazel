load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

exports_files(["defs.bzl"])

rust_binary(
    name = "assemble",
    srcs = ["assemble.rs"],
    crate_root = "assemble.rs",
    visibility = [
        "//library:__pkg__",
        "//program:__subpackages__",
    ],
    deps = [
        "//language:photonic",
        "@crate//:clap",
        "@crate//:serde_json",
    ],
)

rust_library(
    name = "launch",
    srcs = ["launch.rs"],
    crate_name = "launch",
    crate_root = "launch.rs",
    visibility = [
        "//library:__pkg__",
        "//program:__subpackages__",
    ],
    deps = ["@rules_rust//rust/runfiles"],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "test",
    srcs = ["test.rs"],
    crate_root = "test.rs",
    data = [
        ":assemble",
        ":check",
        "//command:photonic",
        "//program/composition:pipeline.program",
        "//program/ternary:local",
        "//program/ternary:local.program",
    ],
    env = {
        "CHECK": "$(rlocationpath :check)",
        "ASSEMBLE": "$(rlocationpath :assemble)",
        "LOCAL": "$(rlocationpath //program/ternary:local)",
        "BUNDLE": "$(rlocationpath //program/ternary:local.program)",
        "COMMAND": "$(rlocationpath //command:photonic)",
        "PIPELINE": "$(rlocationpath //program/composition:pipeline.program)",
    },
    deps = [
        "//language:photonic",
        "@crate//:serde_json",
        "@rules_rust//rust/runfiles",
    ],
)

rust_binary(
    name = "check",
    srcs = ["check.rs"],
    crate_root = "check.rs",
    visibility = [
        "//library:__pkg__",
        "//program:__subpackages__",
    ],
    deps = [
        "//language:photonic",
        "@crate//:serde",
        "@crate//:serde_json",
        "@rules_rust//rust/runfiles",
    ],
)
