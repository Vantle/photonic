load("//photonic:defs.bzl", "photonic_library", "photonic_test")

photonic_library(
    name = "and",
    srcs = ["and.particle"],
    visibility = [
        "//program/composition:__pkg__",
        "//theorem/boolean:__pkg__",
        "//theorem/carry:__pkg__",
        "//theorem/induction:__pkg__",
        "//theorem/ternary:__pkg__",
    ],
    deps = ["//library/function:invoke"],
)

photonic_library(
    name = "equal",
    srcs = ["equal.particle"],
    visibility = ["//theorem/boolean:__pkg__"],
    deps = ["//library/function:invoke"],
)

photonic_library(
    name = "not",
    srcs = ["not.particle"],
    visibility = [
        "//program/composition:__pkg__",
        "//theorem/boolean:__pkg__",
        "//theorem/induction:__pkg__",
    ],
    deps = ["//library/function:invoke"],
)

photonic_library(
    name = "or",
    srcs = ["or.particle"],
    visibility = [
        "//theorem/boolean:__pkg__",
        "//theorem/coloring:__pkg__",
        "//theorem/induction:__pkg__",
        "//theorem/ternary:__pkg__",
    ],
    deps = ["//library/function:invoke"],
)

photonic_test(
    name = "not.check",
    preserve = True,
    source = "Invoke.Boolean.Not.True",
    targets = ["False"],
    deps = [":not"],
)

photonic_test(
    name = "not.reject",
    expect = "unreachable",
    preserve = True,
    source = "Invoke.Boolean.Not.True",
    targets = ["True"],
    deps = [":not"],
)

photonic_test(
    name = "not.alternative",
    match = "any",
    preserve = True,
    source = "Invoke.Boolean.Not.True",
    targets = [
        "False",
        "True",
    ],
    deps = [":not"],
)

photonic_test(
    name = "not.history",
    preserve = True,
    source = "Invoke.Boolean.Not.True",
    targets = [
        "False",
        "Invoke.Boolean.Not.True",
    ],
    deps = [":not"],
)

filegroup(
    name = "source",
    srcs = [
        "and.particle",
        "equal.particle",
        "not.particle",
        "or.particle",
    ],
    visibility = ["//library:__pkg__"],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
