load("//photonic:defs.bzl", "photonic_library", "photonic_test")

exports_files(
    [
        "and.particle",
        "equal.particle",
        "not.particle",
        "or.particle",
    ],
    visibility = ["//book:__pkg__"],
)

photonic_library(
    name = "and",
    srcs = ["and.particle"],
    visibility = [
        "//program/composition:__pkg__",
        "//theorem/boolean:__pkg__",
    ],
    deps = ["//library/function:invoke"],
)

photonic_library(
    name = "equal",
    srcs = ["equal.particle"],
    visibility = [
        "//program/composition:__pkg__",
        "//theorem/boolean:__pkg__",
    ],
    deps = ["//library/function:invoke"],
)

photonic_library(
    name = "not",
    srcs = ["not.particle"],
    visibility = [
        "//program/composition:__pkg__",
        "//theorem/boolean:__pkg__",
    ],
    deps = ["//library/function:invoke"],
)

photonic_library(
    name = "or",
    srcs = ["or.particle"],
    visibility = [
        "//theorem/boolean:__pkg__",
        "//theorem/coloring:__pkg__",
    ],
    deps = ["//library/function:invoke"],
)

photonic_test(
    name = "not.check",
    source = "Invoke.Boolean.Not.True",
    target = ["False"],
    deps = [":not"],
)

photonic_test(
    name = "not.reject",
    expect = "unreachable",
    source = "Invoke.Boolean.Not.True",
    target = ["True"],
    deps = [":not"],
)

filegroup(
    name = "source",
    srcs = [
        "and.particle",
        "equal.particle",
        "not.particle",
        "or.particle",
    ],
    visibility = ["//library:__pkg__"],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
