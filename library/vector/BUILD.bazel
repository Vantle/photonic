load("//photonic:defs.bzl", "photonic_library", "photonic_test")

photonic_library(
    name = "erase",
    srcs = ["erase.particle"],
    deps = [
        ":node",
        "//library/chain:erase",
    ],
)

photonic_library(
    name = "merge",
    srcs = ["merge.particle"],
    deps = [
        ":reverse",
        "//library/natural:compare",
    ],
)

photonic_library(
    name = "node",
    srcs = ["node.particle"],
    visibility = ["//program/vector:__pkg__"],
)

photonic_library(
    name = "reverse",
    srcs = ["reverse.particle"],
    visibility = ["//program/vector:__pkg__"],
    deps = [":node"],
)

photonic_library(
    name = "sort",
    srcs = ["sort.particle"],
    visibility = ["//program/vector:__pkg__"],
    deps = [
        ":merge",
        ":reverse",
        "//library/natural:compare",
    ],
)

photonic_test(
    name = "node.end",
    preserve = True,
    source = "Take.Empty",
    target = ["Taken.End.Empty"],
    deps = [":node"],
)

photonic_test(
    name = "node.item",
    path = True,
    preserve = True,
    source = "Insert.Empty.Nil, Stage, [Stored, Stage] Take",
    target = ["Taken.Item.Empty, Taken.Rest.Empty"],
    deps = [":node"],
)

photonic_test(
    name = "node.forget",
    path = True,
    preserve = True,
    source = "Insert.Empty.Nil, Stage, [Stored, Stage] (Forget.Alias, Take)",
    target = ["Clean.Alias, Taken.Item.Empty, Taken.Rest.Empty"],
    deps = [":node"],
)

photonic_test(
    name = "node.link",
    preserve = True,
    source = "Link.Empty",
    target = ["Linked.Nil"],
    deps = [":node"],
)

photonic_test(
    name = "node.lift",
    path = True,
    preserve = True,
    source = "Insert.Empty.Nil, Stage, [Stored, Stage] Link, [Linked] Lift, [Lifted] Take",
    target = ["Taken.Item.Empty, Taken.Rest.Empty"],
    deps = [":node"],
)

photonic_test(
    name = "node.nest",
    path = True,
    preserve = True,
    source = "Insert.Empty.Nil, Inner, [Stored, Inner] (Outer, Forget.Nested), [Clean.Nested] (Wait, Go), [Go, Outer] Insert.Nil, [Stored, Wait] Take.Outside, [Taken.Item.Outside] Take.Inside, [Taken.Item.Inside.Empty, Taken.Rest.Inside.Empty, Taken.Rest.Outside.Empty] Done",
    target = ["Done"],
    deps = [":node"],
)

photonic_test(
    name = "erase.empty",
    preserve = True,
    source = "Function.Vector.Erase.Empty",
    target = ["Return.Vector.Erase"],
    deps = [":erase"],
)

photonic_test(
    name = "erase.nest",
    path = True,
    preserve = True,
    source = "Insert.Empty.Nil, Stage.1, [Stored, Stage.1] (Stage.2, Forget.Stage.3), [Clean.Stage.3] (Stage.4, Stage.5), [Stage.5, Stage.2] Insert.Nil, [Stored, Stage.4] Function.Vector.Erase",
    target = ["Return.Vector.Erase"],
    deps = [":erase"],
)

photonic_test(
    name = "reverse.empty",
    preserve = True,
    source = "Function.Vector.Reverse.Empty",
    target = ["Return.Vector.Reverse.Empty"],
    deps = [":reverse"],
)

photonic_test(
    name = "sort.empty",
    occurrence = 1024,
    preserve = True,
    source = "Function.Vector.Sort.Empty",
    target = ["Return.Vector.Sort.Empty"],
    deps = [":sort"],
)

photonic_test(
    name = "sort.single",
    occurrence = 1024,
    path = True,
    preserve = True,
    source = "Insert.Zero.Nil, Stage, [Stored, Stage] Function.Vector.Sort, [Return.Vector.Sort] Take",
    target = ["Taken.Item.Zero, Taken.Rest.Empty"],
    deps = [":sort"],
)

filegroup(
    name = "source",
    srcs = [
        "erase.particle",
        "merge.particle",
        "node.particle",
        "reverse.particle",
        "sort.particle",
    ],
    visibility = ["//library:__pkg__"],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
