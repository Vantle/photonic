load("//photonic:defs.bzl", "photonic_library")

photonic_library(
    name = "check",
    srcs = ["check.particle"],
    deps = ["//library/function:invoke"],
)

photonic_library(
    name = "count",
    srcs = ["count.particle"],
    deps = ["//library/function:invoke"],
)

photonic_library(
    name = "filter",
