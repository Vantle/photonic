load("//photonic:defs.bzl", "photonic_library", "photonic_test")

photonic_library(
    name = "cell",
    srcs = ["cell.particle"],
    visibility = ["//theorem/chain:__pkg__"],
)

photonic_library(
    name = "erase",
    srcs = ["erase.particle"],
    visibility = [
        "//library/expression:__pkg__",
        "//library/integer:__pkg__",
        "//library/natural:__pkg__",
        "//library/vector:__pkg__",
    ],
    deps = [":cell"],
)

photonic_library(
    name = "reverse",
    srcs = ["reverse.particle"],
    visibility = [
        "//library/expression:__pkg__",
        "//library/natural:__pkg__",
        "//theorem/natural:__pkg__",
    ],
    deps = [":cell"],
)

photonic_test(
    name = "cell.check",
    path = True,
    source = "Push.Item.Zero, [Drop.Item] Forget, [Built] Read",
    target = ["Yield.Item.Zero"],
    deps = [":cell"],
)

photonic_test(
    name = "cell.peek",
    path = True,
    source = "Push.Item.Zero, [Drop.Item] Forget, [Built] (Peek, Keep), [Seen.Item.Zero, Keep] Read",
    target = ["Yield.Item.Zero"],
    deps = [":cell"],
)

photonic_test(
    name = "cell.end",
    source = "Peek.Zero",
    target = ["Seen.End.Zero"],
    deps = [":cell"],
)

photonic_test(
    name = "reverse.order",
    every = True,
    source = """Push.Item.Zero, Stage.1,
[Drop.Item] Forget,
[Yield.Item.Reverse.Wait] (Reverse.Left, Forget.Reverse.Put.Item),
[Clean.Reverse.Put.Item, Reverse.Right] (Push.Item, Forget.Reverse.Await),
[Built, Stage.1] (Function.Chain.Reverse, Forget.Stage.2),
[Return.Chain.Reverse, Clean.Stage.2] Read.Probe,
[Yield.Item.Probe.Zero] Done""",
    target = ["Done"],
    deps = [":reverse"],
)

photonic_test(
    name = "reverse.zero",
    path = True,
    source = "Function.Chain.Reverse.Zero",
    target = ["Return.Chain.Reverse.Zero"],
    deps = [":reverse"],
)

filegroup(
    name = "source",
    srcs = [
        "cell.particle",
        "erase.particle",
        "reverse.particle",
    ],
    visibility = ["//library:__pkg__"],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
