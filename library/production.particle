[Function.Copy.Pair] (Build.Left, Build.Right)
[Function.Repeat.Pair] (Map.Ready.Left, Map.Ready.Right)
[Function.Broadcast] (Ready.Left, Ready.Right)

[Build.Left] (
    Function.Produce
    [Return] Ready.Left
)

[Build.Right] (
    Function.Produce
    [Return] Ready.Right
)

[Function.Produce.([Value] True)] Return.True
[Function.Produce.([Value] False)] Return.False
[Function.Produce.([Value] 0)] Return.0
[Function.Produce.([Value] 1)] Return.1
[Function.Produce.([Value] 2)] Return.2

[Function.Repeat.Empty] Return

[Produce.([Each] Produce)] Function.Produce
