load("//photonic:defs.bzl", "photonic_library")

photonic_library(
    name = "evaluate",
    srcs = ["evaluate.particle"],
    visibility = ["//visibility:public"],
    deps = [
        ":execute",
        ":parse",
    ],
)

photonic_library(
    name = "execute",
    srcs = ["execute.particle"],
    visibility = ["//visibility:public"],
    deps = [
        ":join",
        ":split",
        "//library/chain:erase",
        "//library/integer:add",
        "//library/integer:divide",
        "//library/integer:multiply",
        "//library/integer:subtract",
        "//library/natural:normalize",
    ],
)

photonic_library(
    name = "join",
    srcs = ["join.particle"],
    visibility = ["//visibility:public"],
    deps = [
        ":token",
        "//library/chain:reverse",
        "//library/natural:digit",
    ],
)

photonic_library(
    name = "parse",
    srcs = ["parse.particle"],
    visibility = ["//visibility:public"],
    deps = [
        ":token",
        "//library/chain:erase",
        "//library/chain:reverse",
        "//library/natural:digit",
    ],
)

photonic_library(
    name = "split",
    srcs = ["split.particle"],
    visibility = ["//visibility:public"],
    deps = [
        ":token",
        "//library/chain:erase",
        "//library/chain:reverse",
        "//library/natural:digit",
    ],
)

photonic_library(
    name = "token",
    srcs = ["token.particle"],
    visibility = ["//visibility:public"],
    deps = [
        "//library/chain:erase",
        "//library/chain:reverse",
    ],
)

filegroup(
    name = "source",
    srcs = [
        "evaluate.particle",
        "execute.particle",
        "join.particle",
        "parse.particle",
        "split.particle",
        "token.particle",
    ],
    visibility = ["//library:__pkg__"],
)

filegroup(
    name = "build",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
