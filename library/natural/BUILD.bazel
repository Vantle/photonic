photonic_test(
    name = "copy.hold",
    path = True,
    source = """Push.([Digit] 1).Zero, Stage.1, Stage.2, Stage.3,
[Built, Stage.1] Function.Natural.Copy,
[Return.Natural.Copy.Left, Stage.2] Function.Chain.Erase.Stage.4,
[Return.Natural.Copy.Right, Stage.3] (Return.Natural.Copy.Right, Forget.Stage.5),
[Return.Chain.Erase.Stage.4, Clean.Stage.5] (Push.([Digit] 2).Zero, Stage.6, Stage.7),
[Built, Stage.6] Function.Natural.Copy,
[Return.Natural.Copy.Left, Stage.7] Read.Stage.8,
[Yield.([Digit] 2).Stage.8.Zero] (Stage.9, Stage.10),
[Return.Natural.Copy.Right, Stage.9] Read.Stage.11,
[Return.Natural.Copy.Right, Stage.10] Read.Stage.12,
[Yield.([Digit] 1).Stage.11.Zero] One,
[Yield.([Digit] 2).Stage.11.Zero] Two,
[Yield.([Digit] 1).Stage.12.Zero] One,
[Yield.([Digit] 2).Stage.12.Zero] Two,
[One, Two] Done""",
    target = ["Done"],
    deps = [
        ":copy",
        "//library/chain:erase",
    ],
)

photonic_test(
    name = "divide.hold",
    coherence = 256,
    configuration = 8192,
    occurrence = 2048,
    path = True,
    scope = 256,
    source = """Push.([Digit] 1).Zero, Stage.1, Stage.7, Stage.8,
[Built, Stage.1] (Push.([Digit] 2), Forget.Stage.2),
[Built, Clean.Stage.2] (Operand.Left, Forget.Stage.3),
[Clean.Stage.3] (Push.([Digit] 1).Zero, Stage.4),
[Built, Stage.4] (Push.([Digit] 0), Forget.Stage.5),
[Built, Clean.Stage.5] (Operand.Right, Forget.Stage.6),
[Clean.Stage.6] Function.Natural.Divide,
[Return.Natural.Divide.Quotient, Stage.7] Function.Chain.Erase.Stage.9,
[Return.Natural.Divide.Remainder, Stage.8] (Return.Natural.Divide.Remainder, Forget.Stage.10),
[Return.Chain.Erase.Stage.9, Clean.Stage.10] (Push.([Digit] 2).Zero, Stage.11),
[Built, Stage.11] (Push.([Digit] 1), Forget.Stage.12),
[Built, Clean.Stage.12] (Operand.Left, Forget.Stage.13),
[Clean.Stage.13] (Push.([Digit] 2).Zero, Stage.14),
[Built, Stage.14] (Operand.Right, Forget.Stage.15),
[Clean.Stage.15] (Function.Natural.Divide, Stage.16),
[Return.Natural.Divide.Quotient, Stage.16] Read.Stage.17,
[Yield.([Digit] 0).Stage.17] Read.Stage.18,
[Yield.([Digit] 1).Stage.18.Zero] (Stage.19, Stage.20),
[Return.Natural.Divide.Remainder, Stage.19] Read.Stage.21,
[Return.Natural.Divide.Remainder, Stage.20] Read.Stage.22,
[Yield.([Digit] 1).Stage.21.Zero] One,
[Yield.([Digit] 2).Stage.21.Zero] Two,
[Yield.([Digit] 1).Stage.22.Zero] One,
[Yield.([Digit] 2).Stage.22.Zero] Two,
[One, Two] Done""",
    target = ["Done"],
    deps = [":divide"],
)

