photonic_test(
    name = "column.fork",
    preserve = True,
    source = "Column.Step",
    targets = ["Column.Request.([Side] Left), Column.Request.([Side] Right)"],
    deps = [":column"],
)

photonic_test(
    name = "column.read",
    preserve = True,
    source = "Read.Zero.Column.Reader.([Side] Left), Read.Zero.Column.Reader.([Side] Right)",
    targets = ["Column.Left.Zero, Column.Right.Zero, Clean.Column.Value.([First] End), Clean.Column.Value.([Second] End)"],
    deps = [":column"],
)

photonic_test(
    name = "column.association",
    preserve = True,
    source = "Yield.([Digit] 1).Zero.Column.Reader.([Side] Left), Yield.([Digit] 2).Zero.Column.Reader.([Side] Right)",
    targets = ["Column.Left.Zero, Column.Right.Zero, Clean.Column.Value.([First] 1), Clean.Column.Value.([Second] 2)"],
    deps = [":column"],
)

photonic_test(
    name = "column.exchange",
    expect = "unreachable",
    preserve = True,
    source = "Yield.([Digit] 1).Zero.Column.Reader.([Side] Left), Yield.([Digit] 2).Zero.Column.Reader.([Side] Right)",
    targets = ["Column.Left.Zero, Column.Right.Zero, Clean.Column.Value.([First] 2), Clean.Column.Value.([Second] 1)"],
    deps = [":column"],
)

photonic_test(
    name = "column.completion",
    expect = "unreachable",
    preserve = True,
    source = "Return.Natural.Column.Positive.Zero, Execute.Pending.Add",
    targets = ["Return.Natural.Add.Zero.Execute"],
    deps = [":add"],
)

photonic_test(
    name = "column.begin",
    preserve = True,
    source = "Function.Natural.Column, Operand.Left.Zero, Operand.Right.Zero",
    targets = ["Column.Left.Zero, Column.Right.Zero, Clean.Column.Value.([First] End), Clean.Column.Value.([Second] End), Column.Output.Zero, Column.Carry.0"],
    deps = [":column"],
)

photonic_test(
    name = "compare.order",
    preserve = True,
    source = "Seen.([Digit] 1).Zero, Compare.Wait.Right.Equal.([Digit] 2)",
    targets = ["Compare.Cursor.Right.Zero, Compare.Go.Left, Compare.Wait.Left.Greater"],
    deps = [":compare"],
)

photonic_test(
    name = "compare.exchange",
    expect = "unreachable",
    preserve = True,
    source = "Seen.([Digit] 1).Zero, Compare.Wait.Right.Equal.([Digit] 2)",
    targets = ["Compare.Cursor.Right.Zero, Compare.Go.Left, Compare.Wait.Left.Less"],
    deps = [":compare"],
)

photonic_test(
    name = "compare.length",
    preserve = True,
    source = "Seen.([Digit] 1).Zero, Compare.Wait.Right.Equal.End",
    targets = ["Clean.Compare.Close.Less"],
    deps = [":compare"],
)

photonic_test(
    name = "compare.padding",
    expect = "unreachable",
    preserve = True,
    source = "Seen.([Digit] 1).Zero, Compare.Wait.Right.Equal.End",
    targets = ["Clean.Compare.Close.Equal"],
    deps = [":compare"],
)

photonic_test(
    name = "compare.drain",
    preserve = True,
    source = "Seen.End.Zero, Compare.Wait.Right.Equal.([Digit] 2), Compare.Cursor.Left.Zero",
    targets = ["Compare.Answer.Left, Compare.Answer.Right, Return.Natural.Compare.Greater"],
    deps = [":compare"],
)

photonic_test(
    name = "compare.zero",
    preserve = True,
    source = "Function.Natural.Compare, Operand.Left.Zero, Operand.Right.Zero",
    targets = ["Return.Natural.Compare.Left.Zero, Return.Natural.Compare.Right.Zero, Return.Natural.Compare.Equal"],
    deps = [":compare"],
)

photonic_test(
    name = "compare.verdict",
    expect = "unreachable",
    preserve = True,
    source = "Function.Natural.Compare, Operand.Left.Zero, Operand.Right.Zero",
    targets = [
        "Return.Natural.Compare.Left.Zero, Return.Natural.Compare.Right.Zero, Return.Natural.Compare.Less",
        "Return.Natural.Compare.Left.Zero, Return.Natural.Compare.Right.Zero, Return.Natural.Compare.Greater",
    ],
    deps = [":compare"],
)

photonic_test(
    name = "copy.left",
    preserve = True,
    source = "Yield.End.Copy.Wait.Zero, Copy.Left.Zero",
    targets = ["Return.Natural.Copy.Left.Zero, Copy.End.([Side] Right)"],
    deps = [":copy"],
)

photonic_test(
    name = "copy.right",
    preserve = True,
    source = "Yield.End.Copy.Wait.Zero, Copy.Right.Zero",
    targets = ["Copy.End.([Side] Left), Return.Natural.Copy.Right.Zero"],
    deps = [":copy"],
)

