[Gather.Done.Left.True, Gather.Done.Right.False] Return.([Left] True).([Right] False)
[Gather.Done.Left.False, Gather.Done.Right.True] Return.([Left] False).([Right] True)
[Gather.Done.Left.False, Gather.Done.Right.False] Return.([Left] False).([Right] False)

[Reduce.Done.Left.True, Reduce.Done.Right.True] Combine.True.True
[Reduce.Done.Left.True, Reduce.Done.Right.False] Combine.True.False
[Reduce.Done.Left.False, Reduce.Done.Right.True] Combine.False.True
[Reduce.Done.Left.False, Reduce.Done.Right.False] Combine.False.False

