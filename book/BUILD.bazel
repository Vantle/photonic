load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//toolchain:defs.bzl", "script_binary", "script_test")
load("//toolchain:notice.bzl", "notice")
load(":library.bzl", "library")
load(":site.bzl", "REPOSITORY", "site")

filegroup(
    name = "asset",
    srcs = [
        "book.css",
        "book.js",
        "calculator.js",
        "chooser.js",
        "connection.js",
        "editor.js",
        "engine.js",
        "example.js",
        "graph.js",
        "hypergraph.js",
        "icon.svg",
        "lens.js",
        "lightbox.js",
        "logo/mark.png",
        "numeral.js",
        "palette.js",
        "pattern.js",
        "record.js",
        "render.js",
        "run.js",
        "share.js",
        "status.js",
        "symmetry.js",
        "syntax.js",
        "theme.js",
        "trace.js",
        "viewer.js",
        "workbench.js",
        "worker.js",
    ],
)

filegroup(
    name = "source",
    srcs = [
        "//frontend:parser.rs",
        "//library/boolean:and.particle",
        "//library/boolean:equal.particle",
        "//library/boolean:not.particle",
        "//library/boolean:or.particle",
        "//library/function:invoke.particle",
        "//library/ternary:add.particle",
        "//program/association:broadcast.wave",
        "//program/association:independent.wave",
        "//program/language:coherence.wave",
        "//program/language:conjunction.wave",
        "//program/language:dynamic.wave",
        "//program/language:inference.wave",
        "//program/language:replacement.wave",
        "//program/natural:addition.wave",
        "//program/ternary:reversal.wave",
        "//theorem:case.particle",
        "//theorem/boolean:involution.wave",
        "//theorem/lattice:converse.wave",
        "//theorem/lattice:order.wave",
    ],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
        "library.bzl",
        "site.bzl",
    ],
    visibility = ["//:__pkg__"],
)

library(
    name = "library",
    deps = [
        "//library/binary:multiply",
        "//library/binary:sum",
        "//library/boolean:and",
        "//library/boolean:equal",
        "//library/boolean:not",
        "//library/boolean:or",
        "//library/carry:combine",
        "//library/carry:equal",
        "//library/carry:evaluate",
        "//library/chain:cell",
        "//library/chain:erase",
        "//library/chain:reverse",
        "//library/collection:broadcast",
        "//library/collection:choose",
        "//library/collection:copy",
        "//library/collection:gather",
        "//library/collection:map",
        "//library/collection:produce",
        "//library/collection:reduce",
        "//library/collection:repeat",
        "//library/collection:unpack",
        "//library/expression:evaluate",
        "//library/expression:execute",
        "//library/expression:join",
        "//library/expression:parse",
        "//library/expression:split",
        "//library/expression:token",
        "//library/field:pack",
        "//library/field:unpack",
        "//library/function:compose",
        "//library/function:identity",
        "//library/function:invoke",
        "//library/integer:add",
        "//library/integer:divide",
        "//library/integer:multiply",
        "//library/integer:result",
        "//library/integer:subtract",
        "//library/natural:add",
        "//library/natural:column",
        "//library/natural:compare",
        "//library/natural:complement",
        "//library/natural:copy",
        "//library/natural:difference",
        "//library/natural:digit",
        "//library/natural:divide",
        "//library/natural:multiply",
        "//library/natural:normalize",
        "//library/natural:subtract",
        "//library/natural:successor",
        "//library/natural:trim",
        "//library/selection:check",
        "//library/selection:count",
        "//library/selection:filter",
        "//library/selection:reduce",
        "//library/stream:successor",
        "//library/ternary:add",
        "//library/ternary:compare",
        "//library/ternary:equal",
        "//library/ternary:multiply",
        "//library/ternary:select",
        "//library/ternary:subtract",
        "//library/ternary:successor",
        "//library/ternary:sum",
        "//library/vector:erase",
        "//library/vector:merge",
        "//library/vector:node",
        "//library/vector:reverse",
        "//library/vector:sort",
    ],
)

notice(
    name = "notice",
    target = ["//toolchain/browser:module"],
)

site(
    name = "site",
    srcs = [
        ":asset",
        ":library",
        ":notice",
        "//:lightbox",
        "//:page",
        "//toolchain/browser:javascript",
        "//toolchain/browser:webassembly",
    ],
)

rust_binary(
    name = "serve",
    srcs = [
        "route.rs",
        "serve.rs",
    ],
    crate_root = "serve.rs",
    data = [
        ":asset",
        ":library",
        ":notice",
        "//:lightbox",
        "//:page",
        "//toolchain/browser:javascript",
        "//toolchain/browser:webassembly",
    ],
    env = {
        "BOOK": "$(rlocationpaths :asset) $(rlocationpath :library) $(rlocationpath :notice) $(rlocationpath //:page) $(rlocationpath //:lightbox) $(rlocationpath //toolchain/browser:javascript) $(rlocationpath //toolchain/browser:webassembly)",
    },
    lint_config = "//:lint",
    rustc_env = {"REPOSITORY": REPOSITORY},
    deps = ["@rules_rust//rust/runfiles"],
)

rust_test(
    name = "route",
    size = "small",
    srcs = [
        "route.rs",
        "test/route.rs",
    ],
    crate_root = "route.rs",
    lint_config = "//:lint",
)

script_binary(
    name = "record",
    argument = ["write"],
    data = [":source"],
    runfile = [
        "//toolchain/browser:javascript",
        "//toolchain/browser:webassembly",
        "numeral.js",
        "//:page",
        "//:lightbox",
        "record.js",
    ],
    script = "record.mjs",
)

script_test(
    name = "record.check",
    size = "small",
    argument = ["check"],
    data = [":source"],
    runfile = [
        "//toolchain/browser:javascript",
        "//toolchain/browser:webassembly",
        "numeral.js",
        "//:page",
        "//:lightbox",
        "record.js",
    ],
    script = "record.mjs",
)

script_test(
    name = "test",
    size = "small",
    runfile = [
        "//toolchain/browser:javascript",
        "//toolchain/browser:webassembly",
        "pattern.json",
        "numeral.js",
        "record.js",
        "engine.js",
        "syntax.js",
        "render.js",
        "editor.js",
        "graph.js",
        "pattern.js",
        "symmetry.js",
        "share.js",
        ":library",
    ],
    script = "test.mjs",
)

script_test(
    name = "check",
    size = "small",
    data = [
        ":asset",
        ":notice",
        "//:lightbox",
        "//:page",
        "@rules_browsers_chrome_mac_arm//:info",
        "@rules_browsers_chromedriver_mac_arm//:info",
    ],
    runfile = [
        "@rules_browsers_chrome_mac_arm//:chrome-headless-shell-mac-arm64/chrome-headless-shell",
        "@rules_browsers_chromedriver_mac_arm//:chromedriver-mac-arm64/chromedriver",
        "//toolchain/browser:webassembly",
        "//toolchain/browser:javascript",
        ":library",
    ],
    script = "check.mjs",
    tags = [
        "manual",
        "requires-network",
    ],
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

exports_files(
    ["pattern.json"],
    visibility = ["//spectrum:__pkg__"],
)
