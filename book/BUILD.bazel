load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//toolchain:defs.bzl", "script_binary", "script_test")
load(":site.bzl", "REPOSITORY", "site")

filegroup(
    name = "asset",
    srcs = [
        "book.css",
        "book.js",
        "calculator.js",
        "connection.js",
        "editor.js",
        "engine.js",
        "example.js",
        "graph.js",
        "hypergraph.js",
        "icon.svg",
        "lens.js",
        "lightbox.js",
        "numeral.js",
        "palette.js",
        "pattern.js",
        "record.js",
        "render.js",
        "run.js",
        "share.js",
        "status.js",
        "symmetry.js",
        "syntax.js",
        "theme.js",
        "trace.js",
        "viewer.js",
        "workbench.js",
        "worker.js",
    ],
)

filegroup(
    name = "source",
    srcs = [
        "//frontend:parser.rs",
        "//library/boolean:and.particle",
        "//library/boolean:equal.particle",
        "//library/boolean:not.particle",
        "//library/boolean:or.particle",
        "//library/function:invoke.particle",
        "//library/ternary:add.particle",
        "//program/association:broadcast.wave",
        "//program/association:independent.wave",
        "//program/language:coherence.wave",
        "//program/language:conjunction.wave",
        "//program/language:dynamic.wave",
        "//program/language:inference.wave",
        "//program/language:replacement.wave",
        "//program/natural:addition.wave",
        "//program/ternary:reversal.wave",
        "//theorem:case.particle",
        "//theorem/boolean:involution.wave",
        "//theorem/lattice:converse.wave",
        "//theorem/lattice:order.wave",
    ],
)

filegroup(
    name = "build",
    srcs = [
        "BUILD.bazel",
        "site.bzl",
    ],
    visibility = ["//:__pkg__"],
)

site(
    name = "site",
    srcs = [
        ":asset",
        "//:lightbox",
        "//:page",
        "//toolchain/browser:javascript",
        "//toolchain/browser:webassembly",
    ],
)

rust_binary(
    name = "serve",
    srcs = [
        "route.rs",
        "serve.rs",
    ],
    crate_root = "serve.rs",
    data = [
        ":asset",
        "//:lightbox",
        "//:page",
        "//toolchain/browser:javascript",
        "//toolchain/browser:webassembly",
    ],
    env = {
        "BOOK": "$(rlocationpaths :asset) $(rlocationpath //:page) $(rlocationpath //:lightbox) $(rlocationpath //toolchain/browser:javascript) $(rlocationpath //toolchain/browser:webassembly)",
    },
    lint_config = "//:lint",
    rustc_env = {"REPOSITORY": REPOSITORY},
    deps = ["@rules_rust//rust/runfiles"],
)

rust_test(
    name = "route",
    size = "small",
    srcs = [
        "route.rs",
        "test/route.rs",
    ],
    crate_root = "route.rs",
    lint_config = "//:lint",
)

script_binary(
    name = "record",
    argument = ["write"],
    data = [":source"],
    runfile = [
        "//toolchain/browser:javascript",
        "//toolchain/browser:webassembly",
        "numeral.js",
        "//:page",
        "//:lightbox",
        "record.js",
    ],
    script = "record.mjs",
)

script_test(
    name = "record.check",
    size = "small",
    argument = ["check"],
    data = [":source"],
    runfile = [
        "//toolchain/browser:javascript",
        "//toolchain/browser:webassembly",
        "numeral.js",
        "//:page",
        "//:lightbox",
        "record.js",
    ],
    script = "record.mjs",
)

script_test(
    name = "test",
    size = "small",
    runfile = [
        "//toolchain/browser:javascript",
        "//toolchain/browser:webassembly",
        "pattern.json",
        "numeral.js",
        "record.js",
        "engine.js",
        "syntax.js",
        "render.js",
        "editor.js",
        "graph.js",
        "pattern.js",
        "symmetry.js",
        "share.js",
    ],
    script = "test.mjs",
)

script_test(
    name = "check",
    size = "small",
    data = [
        ":asset",
        "//:lightbox",
        "//:page",
        "@rules_browsers_chrome_mac_arm//:info",
        "@rules_browsers_chromedriver_mac_arm//:info",
    ],
    runfile = [
        "@rules_browsers_chrome_mac_arm//:chrome-headless-shell-mac-arm64/chrome-headless-shell",
        "@rules_browsers_chromedriver_mac_arm//:chromedriver-mac-arm64/chromedriver",
        "//toolchain/browser:webassembly",
        "//toolchain/browser:javascript",
    ],
    script = "check.mjs",
    tags = [
        "manual",
        "requires-network",
    ],
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

exports_files(
    ["pattern.json"],
    visibility = ["//spectrum:__pkg__"],
)
